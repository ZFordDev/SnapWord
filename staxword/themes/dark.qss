/* StaxWord — Dark Theme (Google Docs-style) */

/* ── Global defaults ─────────────────────────────────────── */
QWidget {
    background-color: #202124;
    color: #e8eaed;
    font-family: 'Segoe UI', 'SF Pro Text', 'Ubuntu', sans-serif;
    font-size: 13px;
}

/* ── Menu bar ────────────────────────────────────────────── */
QMenuBar {
    background-color: #303134;
    border-bottom: 1px solid #3c4043;
    padding: 4px 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    color: #9aa0a6;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3c4043;
    color: #e8eaed;
}

/* ── Dropdown menus ──────────────────────────────────────── */
QMenu {
    background-color: #303134;
    border: 1px solid #3c4043;
    border-radius: 8px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 20px 6px 16px;
    color: #bdc1c6;
}

QMenu::item:selected {
    background-color: #2d3748;
    color: #8ab4f8;
}

/* ── Toolbar ─────────────────────────────────────────────── */
QToolBar {
    background-color: #303134;
    border-bottom: 1px solid #3c4043;
    padding: 2px 8px;
    spacing: 2px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    color: #9aa0a6;
    font-size: 13px;
    font-weight: 600;
    min-width: 28px;
    min-height: 28px;
}

QToolBar QToolButton:hover {
    background-color: #3c4043;
    border-color: #5f6368;
}

QToolBar QToolButton:checked {
    background-color: #1a3654;
    border-color: #8ab4f8;
    color: #8ab4f8;
}

QToolBar QToolButton:pressed {
    background-color: #1a3654;
}

/* Bold button */
QToolBar QToolButton#BoldBtn {
    font-weight: 800;
    font-size: 14px;
}

/* Italic button */
QToolBar QToolButton#ItalicBtn {
    font-style: italic;
    font-size: 14px;
}

/* Underline button */
QToolBar QToolButton#UnderlineBtn {
    font-size: 14px;
    text-decoration: underline;
}

/* Strikethrough button */
QToolBar QToolButton#StrikethroughBtn {
    font-size: 14px;
    text-decoration: line-through;
}

/* Font combo boxes */
QToolBar QFontComboBox {
    background-color: #303134;
    border: 1px solid #3c4043;
    border-radius: 4px;
    padding: 2px 8px;
    color: #e8eaed;
    font-size: 12px;
    min-height: 26px;
}

QToolBar QFontComboBox:hover {
    border-color: #8ab4f8;
}

QToolBar QFontComboBox::drop-down {
    border: none;
    width: 20px;
}

QToolBar QComboBox {
    background-color: #303134;
    border: 1px solid #3c4043;
    border-radius: 4px;
    padding: 2px 8px;
    color: #e8eaed;
    font-size: 12px;
    min-height: 26px;
}

QToolBar QComboBox:hover {
    border-color: #8ab4f8;
}

QToolBar QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* ── Sidebar (file tree) ─────────────────────────────────── */
QTreeView#FileTreeList {
    background-color: #303134;
    border: none;
    border-right: 1px solid #3c4043;
    padding: 12px;
    font-size: 13px;
}

QTreeView::item {
    padding: 5px 8px;
    border-radius: 4px;
    color: #bdc1c6;
    margin: 1px 4px;
}

QTreeView::item:hover {
    background-color: #3c4043;
}

QTreeView::item:selected {
    background-color: #1a3654;
    color: #8ab4f8;
}

/* ── Splitter handles ────────────────────────────────────── */
QSplitter#AppContainer::handle {
    background-color: #3c4043;
    width: 1px;
}

/* ── Page workspace (dark gray background) ───────────────── */
QWidget#PageWorkspace {
    background-color: #1a1a1d;
    border: none;
}

/* ── Page wrapper (centers the dark page) ────────────────── */
QWidget#PageWrapper {
    background: transparent;
}

/* ── Page container (dark page) ──────────────────────────── */
QWidget#PageContainer {
    background-color: #2d2d30;
    border: 1px solid #3c4043;
    border-radius: 2px;
}

/* ── Editor (rich text) ──────────────────────────────────── */
QTextEdit#RichTextEdit {
    background-color: #2d2d30;
    color: #e8eaed;
    padding: 72px 96px;
    border: none;
    selection-background-color: #264f78;
    font-family: 'Arial', 'Calibri', sans-serif;
    font-size: 11pt;
    line-height: 1.5;
}

/* ── Footer ──────────────────────────────────────────────── */
QWidget#AppFooter {
    background-color: #303134;
    border-top: 1px solid #3c4043;
    max-height: 28px;
}

QWidget#AppFooter QLabel {
    color: #9aa0a6;
    font-size: 11px;
}
